# Reddit API — https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Format: "narrativesignal/1.0 by u/<your-username> (contact: <email>)"
# Nominatim policy requires the contact; Reddit is not that strict but a real UA
# reduces rate-limiting.
REDDIT_USER_AGENT=

# Globe pipeline — Nominatim geocoding (backend/globe/app/pipeline/geo_resolver.py)
# Format: "narrativesignal-globe/1.0 by u/<your-username> (contact: <email>)"
# Nominatim's usage policy requires a contactable User-Agent; a generic one risks
# the pipeline being rate-limited or blocked. Same reject-generic-UA guard as
# REDDIT_USER_AGENT above (rejects values containing python:asyncpraw, changeme,
# or default).
GLOBE_NOMINATIM_UA=
